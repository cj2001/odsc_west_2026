# Template. Copy to .env before starting anything — docker compose FAILS to start
# without it, because the jupyter service loads this file:
#
#     cp .env.example .env
#
# The real .env is git-ignored.
#
# Everything here is optional EXCEPT HOST_UID/HOST_GID, which ./scripts/start.sh
# fills in for you. The workshop runs end to end with every key below left blank.

# --- Container user ------------------------------------------------------
# The jupyter container runs as this uid:gid so that files it writes into
# ./notebooks and ./data belong to you. ./scripts/start.sh fills these in with
# your real `id -u` / `id -g` - you should not need to edit them by hand.
#
# Do NOT rename these to UID/GID: bash sets UID but never exports it, and never
# sets GID at all, so compose would silently fall back to 1000:1000 and anyone
# whose uid is not 1000 would get permission errors.
HOST_UID=1000
HOST_GID=1000

# --- LLM ------------------------------------------------------------------
# Needed for the RAG and scavenger hunt notebooks. Bring your own key.
#
# You only need ONE of these. The notebooks take a provider argument:
#     ask(question, provider="anthropic")   -> uses ANTHROPIC_API_KEY
#     ask(question, provider="openai")      -> uses OPENAI_API_KEY
#
# Leave the other blank. After editing this file, recreate the containers so
# they pick the values up - editing .env does nothing to a running container:
#
#     docker compose up -d
#
# Get a key at https://console.anthropic.com/ or https://platform.openai.com/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Placekey ------------------------------------------------------------
# NOT needed for the workshop. The database ships with the geocoding already
# applied. Only set this if you want to re-run the geocoding notebook yourself.
# Free tier: https://www.placekey.io/
PLACEKEY_API_KEY=

# --- Senzing licence -----------------------------------------------------
# NOT needed for the workshop. The database ships already entity-resolved, and
# READING a resolved database is unlimited. The free 500-record limit only
# applies to LOADING records, which the sandbox exercises stay well under.
#
# Only set this if you want to rebuild the database from the source files, which
# needs a licence covering 39,413 records. Request an evaluation licence from
# Senzing, then either paste the base64 string on one line here (line breaks
# removed)...
SENZING_LICENSE_BASE64=

# ...or point at the base64 licence file instead. scripts/init_database.sh uses
# SENZING_LICENSE_BASE64 if set, and falls back to this path.
SENZING_LICENSE_FILE=
