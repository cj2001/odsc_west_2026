# Template. Copy to .env and fill in. The real .env is git-ignored.

# --- Placekey ------------------------------------------------------------
# Get a key at https://www.placekey.io/ (free tier). Paste it below.
PLACEKEY_API_KEY=your-placekey-api-key-here

# --- Senzing licence -----------------------------------------------------
# Base64 licence lives in g2.lic_base64 at the project root (also git-ignored).
# Scripts read the file and inject it as PIPELINE.LICENSESTRINGBASE64.
SENZING_LICENSE_FILE=g2.lic_base64

# --- Senzing datastore (local docker container senzing-pg-odsc) ----------
SENZING_DB_HOST=localhost
SENZING_DB_PORT=5460
SENZING_DB_NAME=G2
SENZING_DB_USER=senzing
SENZING_DB_PASSWORD=changeme

# --- Senzing runtime paths ----------------------------------------------
SENZING_CONFIG_PATH=/etc/opt/senzing
SENZING_RESOURCE_PATH=/opt/senzing/er/resources
SENZING_SUPPORT_PATH=/opt/senzing/data
SENZING_SDK_PYTHONPATH=/opt/senzing/er/sdk/python
SENZING_LD_LIBRARY_PATH=/opt/senzing/er/lib
