# Template. Copy to .env before starting anything — docker compose FAILS to start
# without it, because the jupyter service loads this file:
#
#     cp .env.example .env
#
# The real .env is git-ignored.

# --- Container user ------------------------------------------------------
# The jupyter container runs as this uid:gid so that files it writes into
# ./notebooks and ./data belong to you. ./scripts/start.sh fills these in with
# your real `id -u` / `id -g` - you should not need to edit them by hand.
#
# Do NOT rename these to UID/GID: bash sets UID but never exports it, and never
# sets GID at all, so compose would silently fall back to 1000:1000 and anyone
# whose uid is not 1000 would get permission errors.
HOST_UID=1000
HOST_GID=1000

# --- Senzing licence -----------------------------------------------------
# ONLY needed if you are loading records yourself. Without a licence Senzing
# accepts 500 records; reading an already-loaded database has no limit at all.
#
# To load the full dataset, request a free evaluation licence from Senzing, then
# put the base64 licence on one line below (the g2.lic_base64 file at the project
# root, with its line breaks removed).
#
# Leaving this blank is fine and is the normal case for the workshop.
SENZING_LICENSE_BASE64=

# --- Placekey ------------------------------------------------------------
# Only needed if you geocode addresses yourself. The workshop database ships with
# the geocoding already applied. Free tier: https://www.placekey.io/
PLACEKEY_API_KEY=

# --- LLM ------------------------------------------------------------------
# Needed for the scavenger hunt notebook. Bring your own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Senzing runtime paths ----------------------------------------------
# These match the paths inside the senzing/serve-grpc image. You should not need
# to change them; docker-compose.yml sets the engine configuration directly.
SENZING_CONFIG_PATH=/etc/opt/senzing
SENZING_RESOURCE_PATH=/opt/senzing/er/resources
SENZING_SUPPORT_PATH=/opt/senzing/data
